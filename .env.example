APP_NAME="Suivora360"
APP_URL=https://suivora360.com
APP_DEBUG=false

# Choisir "mysql" en production (IONOS) ou "sqlite" en local pour tester
DB_CONNECTION=mysql

# Paramètres MySQL (à remplir avec les identifiants IONOS)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Utilisé uniquement si DB_CONNECTION=sqlite
DB_SQLITE_PATH=storage/suivora360.sqlite

# Jeton secret à saisir dans l'URL pour lancer l'installation de la base
# (ex: https://suivora360.com/install.php?token=CE_JETON)
# Change cette valeur avant la mise en ligne !
INSTALL_TOKEN=change-moi-avant-mise-en-ligne

# Clé utilisée pour sécuriser les sessions (change cette valeur aussi)
APP_KEY=change-moi-aussi-une-longue-chaine-aleatoire

# Clé API Anthropic (console.anthropic.com), utilisée uniquement par la
# fonction "Extraire les articles avec l'IA" sur une demande. Facultatif :
# tant qu'elle est absente, ce bouton affiche simplement un message d'erreur.
ANTHROPIC_API_KEY=

# Adresse et nom d'expéditeur utilisés pour les emails envoyés par l'appli
# (ex : notification d'assignation d'un collaborateur sur un dossier), via
# la fonction native PHP mail() — aucun service SMTP externe n'est utilisé.
# Facultatif : tant que MAIL_FROM_ADDRESS est vide, aucun email n'est envoyé
# (seule la notification interne/cloche reste active).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Suivora360"
